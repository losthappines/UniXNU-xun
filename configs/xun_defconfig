# Kernel configuration of the Xiaomi Redmi Pad SE 11" (xun, SM6225):
# generic CPU, interrupt, timer and platform expert path, source corecrypto and pthread providers,
# SoftwareAES, 4 KiB code-signing hash cache, and NativeEmmc root storage on sdhci@4744000.

CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_AES=y

# NativeEmmc: Qualcomm SDHCI MSM (sdhci@4744000) eMMC 5.1
# Builds libXunEmmc.a and copies to build/sheng-ufs/libShengUfs.a for upstream XNU_NATIVE_UFS linkage.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_SOURCE_STORAGE=y
CONFIG_XNU_NATIVE_EMMC=y
CONFIG_XNU_NATIVE_EMMC_ARCHIVE="{tree}/build/xun-emmc/libXunEmmc.a"

# Deferred virtual transports / scratch Data seed (eMMC serves physical root directly):
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_VERIFIED_ROOT_PROBE=n
CONFIG_XNU_OWNER_ROOT_AUDIT=y
CONFIG_XNU_OWNER_ROOT_TRUST=y
CONFIG_XNU_OWNER_CACHE_MOUNT=y
CONFIG_XNU_OWNER_CACHE_STARTUP=y
CONFIG_XNU_OWNER_BOOT_MANIFEST=y
CONFIG_XNU_OWNER_DATA_MOUNT=n
CONFIG_XNU_OWNER_UNION_SYSTEMOS=y

# The SystemOS volume of the signed policy and the Data seed volume of the payload.
CONFIG_XNU_OWNER_ROOT_VOLUME_UUID="04769D26-2CA0-4825-B443-E2E5F88300F2"
CONFIG_XNU_OWNER_CACHE_VOLUME_UUID="8846FE78-2910-4297-AF97-D59BB6F8FC16"
CONFIG_XNU_OWNER_DATA_VOLUME_UUID="73F1FA24-4189-446D-96D4-FB6324EBE955"
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y

# SM6225 Kryo 265 cores (Cortex-A73 Gold, Cortex-A53 Silver) are ARMv8.0 and lack PAN.
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_SHENG_PMGR=y

# On-screen bring-up progress bars (requires UEFI Font.h + UFS/owner-root interlock in upstream baseline script; deferred for first CI build)
CONFIG_XNU_BOOT_PROGRESS=n

CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_BUILD_ARCHIVES=y

CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/link-stubs/libLinkStubs.a"
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_NATIVE_ADRENO=n
